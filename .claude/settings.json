{
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(just *)",
      "Bash(rustup show *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:eprint.iacr.org)",
      "Bash(mise *)",
      "Bash(make *)",
      "Bash(buf *)",
      "Bash(docker compose config *)",
      "Bash(docker build *)",
      "Bash(kustomize build *)",
      "Bash(kubectl kustomize *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(cargo publish *)",
      "Bash(rm *)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Bash(docker push *)",
      "Bash(docker compose up *)",
      "Bash(kubectl apply *)",
      "Bash(ansible-playbook *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./target/**)",
      "Edit(//mnt/development/0x19/apex/**)",
      "Edit(//opt/proximity/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ],
    "additionalDirectories": [
      "/mnt/development/0x19/apex",
      "/opt/proximity"
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rustfmt-file.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'After compaction: Rust workspace with engine (gRPC) and protocol (protocol) crates. mise run ci must pass before finishing. Stubs stay labelled stub on every surface.'"
          }
        ]
      }
    ]
  }
}
