# Copy to .env for local overrides. mise loads it automatically.
RUST_LOG=info,tbd=debug
LOG_FORMAT=text
ENGINE_LISTEN_ADDR=127.0.0.1:50051
ENGINE_METRICS_ADDR=127.0.0.1:9464
PROTOCOL_LISTEN_ADDR=127.0.0.1:8080
PROTOCOL_METRICS_ADDR=127.0.0.1:9465
PROTOCOL_ENGINE_URL=http://127.0.0.1:50051
# Traces: unset = no export (trace ids still generated). Local cluster: http://127.0.0.1:4317
#OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
#OTEL_TRACES_SAMPLER_ARG=1.0
# In-process CPU profiles to Pyroscope. Local cluster: http://127.0.0.1:4040
#PYROSCOPE_SERVER_ADDRESS=http://127.0.0.1:4040
# Container registry namespace used by docker/k8s/ansible tasks.
IMAGE_REGISTRY=ghcr.io/0x19
IMAGE_TAG=dev
TBD_ENV=local
#CHAOS_CONFIG_DIR=configs/chaos
#CHAOS_LISTEN_ADDR=127.0.0.1:7700
#CHAOS_BASE_PATH=/api/chaos/v1
# Built UI for `chaos serve`; empty = API only. Local cluster serves it at http://chaos.localhost:18080/
#CHAOS_UI_DIR=ui/chaos/out
# Targets for `chaos validate` and API load runs. Local cluster: http://localhost:18080 and http://localhost:15051
#CHAOS_PROTOCOL_URL=http://127.0.0.1:8080
#CHAOS_ENGINE_URL=http://127.0.0.1:50051
#CHAOS_TOPOLOGY=topologies/dev.toml
#CHAOS_SCENARIOS_DIR=scenarios
#CHAOS_SCENARIOS_SEED=
#CHAOS_RESULTS_DIR=.chaos/results
# Extra PEM root for https:// targets (Caddy's internal CA on a staging edge).
#CHAOS_CA_CERT=
# Public edge domain; derives grafana.|logs.|profiles.|metrics.<domain> links. Empty = the localhost links in local.toml.
#CHAOS_PUBLIC_DOMAIN=
# Auth for validate and load runs against a deployed stack: a fixed token wins, else client-credentials.
#CHAOS_TOKEN=
#CHAOS_AUTH_TOKEN_URL=http://127.0.0.1:4444/oauth2/token
#CHAOS_AUTH_CLIENT_ID=tbd-chaos
#CHAOS_AUTH_CLIENT_SECRET=

  # --- chaos: bearer token for validate/load through Envoy (docs/auth/README.md).
  # Either a fixed token, or the client-credentials grant for the tbd-chaos client.
  # The secret comes from the cluster: kubectl -n auth get secret auth-secrets -o jsonpath='{.data.client-chaos-secret}' | base64 -d
  CHAOS_TOKEN=
  CHAOS_AUTH_TOKEN_URL=https://auth.proximity.is/oauth2/token
  CHAOS_AUTH_CLIENT_ID=tbd-chaos
  CHAOS_AUTH_CLIENT_SECRET=

  # --- compose identity stack (docker compose up). Local-only defaults apply when unset;
  # set real values for anything shared. Client secrets must match what seed-clients registers.
  AUTH_PUBLIC_URL=http://auth.localhost:8080
  AUTH_POSTGRES_PASSWORD=
  HYDRA_SYSTEM_SECRET=
  KRATOS_COOKIE_SECRET=
  KRATOS_CIPHER_SECRET=
  UI_COOKIE_SECRET=
  UI_CSRF_SECRET=
  AUTH_CLIENT_UI_SECRET=
  AUTH_CLIENT_CHAOS_SECRET=
  ENVOY_OAUTH_HMAC=
  GOOGLE_CLIENT_ID=
  GOOGLE_CLIENT_SECRET=
  GITHUB_CLIENT_ID=
  GITHUB_CLIENT_SECRET=

  #CHAOS_SCHEDULES_FILE=.chaos/schedules.json

# ---- ledger (scaffolded by `tbd new service`) ----
LEDGER_LISTEN_ADDR=127.0.0.1:50052
LEDGER_METRICS_ADDR=127.0.0.1:9466
# LEDGER_CONFIG_DIR=configs/ledger
LEDGER_STORE_KIND=memory                     # postgres in compose and the cluster
#LEDGER_DATABASE_URL=postgres://ledger:local-ledger@127.0.0.1:15432/ledger?sslmode=disable
#LEDGER_CLICKHOUSE_URL=http://ledger:local-ledger@127.0.0.1:18123
LEDGER_POSTGRES_PASSWORD=local-ledger        # compose only
LEDGER_CLICKHOUSE_PASSWORD=local-ledger      # compose only
#LEDGER_TEST_DATABASE_URL=                   # tests: an admin URL instead of Docker
#LEDGER_TEST_CLICKHOUSE_URL=


# ---- humans (scaffolded by `tbd new service`) ----
HUMANS_LISTEN_ADDR=127.0.0.1:50053
HUMANS_METRICS_ADDR=127.0.0.1:9467
# HUMANS_CONFIG_DIR=configs/humans
# CHAOS_HUMANS_URL=http://127.0.0.1:50053   # chaos validate target for the humans kind
