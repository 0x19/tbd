              "type": "string"
            },
            "explode": true
          },
          {
            "name": "sources",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "`tbd.ledger.v1.Source`",
              "enum": [
                "SOURCE_UNSPECIFIED",
                "SOURCE_VERIFIED",
                "SOURCE_DECLARED",
                "SOURCE_INFERRED",
                "SOURCE_SYMBOLIC",
                "SOURCE_OBSERVED"
              ]
            },
            "explode": true
          },
          {
            "name": "scopes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "explode": true
          },
          {
            "name": "cursor",
            "in": "query",
