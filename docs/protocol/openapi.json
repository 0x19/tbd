{
  "openapi": "3.1.0",
  "info": {
    "title": "tbd protocol",
    "description": "The edge: REST and server-sent events over the registered gRPC backends. Every body is JSON; every error is the `Problem` envelope.",
    "license": {
      "name": "Proprietary"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin, behind Envoy"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: the process is up.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "The process answers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: every required backend answers `SERVING` to a live health\ncheck. The body lists every registered backend either way, so an optional\none that is down is visible without failing the probe.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Every required backend is serving",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A required backend is not serving",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/v1/engine/subjects/{subject_id}/events": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "tbd.engine.v1.EngineService/Subscribe",
        "description": "Transcoded from `/tbd.engine.v1.EngineService/Subscribe` on the `engine` backend.",
        "operationId": "EngineService.Subscribe",
        "parameters": [
          {
            "name": "subject_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A stream of `tbd.engine.v1.SubscribeResponse` events, one JSON object per `data:`; a failure is an `error` event carrying `Problem`",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/tbd.engine.v1.SubscribeResponse"
                }
              }
            }
          },
          "default": {
            "description": "The error envelope, with the standard gRPC-to-HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/evaluate": {
      "post": {
        "tags": [
          "engine"
        ],
        "summary": "Score a subject once; the engine's `stub` flag is forwarded untouched.",
        "operationId": "evaluate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The score",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evaluation"
                }
              }
            }
          },
          "400": {
            "description": "A malformed body or an empty subject_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "The body is not JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The engine is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ledger/ping": {
      "get": {
        "tags": [
          "ledger"
        ],
        "summary": "tbd.ledger.v1.LedgerService/Ping",
        "description": "Transcoded from `/tbd.ledger.v1.LedgerService/Ping` on the `ledger` backend.",
        "operationId": "LedgerService.Ping",
        "parameters": [
          {
            "name": "message",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`tbd.ledger.v1.PingResponse`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/tbd.ledger.v1.PingResponse"
                }
              }
            }
          },
          "default": {
            "description": "The error envelope, with the standard gRPC-to-HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ledger/subjects/{subject_id}": {
      "delete": {
        "tags": [
          "ledger"
        ],
        "summary": "tbd.ledger.v1.LedgerService/Erase",
        "description": "Transcoded from `/tbd.ledger.v1.LedgerService/Erase` on the `ledger` backend.",
        "operationId": "LedgerService.Erase",
        "parameters": [
          {
            "name": "subject_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`tbd.ledger.v1.EraseResponse`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/tbd.ledger.v1.EraseResponse"
                }
              }
            }
          },
          "default": {
            "description": "The error envelope, with the standard gRPC-to-HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ledger/subjects/{subject_id}/facts": {
      "get": {
        "tags": [
          "ledger"
        ],
        "summary": "tbd.ledger.v1.LedgerService/Current",
        "description": "Transcoded from `/tbd.ledger.v1.LedgerService/Current` on the `ledger` backend.",
        "operationId": "LedgerService.Current",
        "parameters": [
          {
            "name": "subject_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "paths",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "explode": true
          },
          {
            "name": "sources",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "`tbd.ledger.v1.Source`",
              "enum": [
                "SOURCE_UNSPECIFIED",
                "SOURCE_VERIFIED",
                "SOURCE_DECLARED",
                "SOURCE_INFERRED",
                "SOURCE_SYMBOLIC",
                "SOURCE_OBSERVED"
              ]
            },
            "explode": true
          },
          {
            "name": "scopes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "explode": true
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`tbd.ledger.v1.CurrentResponse`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/tbd.ledger.v1.CurrentResponse"
                }
              }
            }
          },
          "default": {
            "description": "The error envelope, with the standard gRPC-to-HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "ledger"
        ],
        "summary": "tbd.ledger.v1.LedgerService/Append",
        "description": "Transcoded from `/tbd.ledger.v1.LedgerService/Append` on the `ledger` backend.",
        "operationId": "LedgerService.Append",
        "parameters": [
          {
            "name": "subject_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "`tbd.ledger.v1.AppendRequest`; path variables override their fields",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/tbd.ledger.v1.AppendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "`tbd.ledger.v1.AppendResponse`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/tbd.ledger.v1.AppendResponse"
                }
              }
            }
          },
          "default": {
            "description": "The error envelope, with the standard gRPC-to-HTTP status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
