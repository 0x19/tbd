    "/v1/ledger/subjects/{subject_id}/retractions": {
      "post": {
        "tags": [
          "ledger"
        ],
        "summary": "tbd.ledger.v1.LedgerService/Retract",
        "description": "Transcoded from `/tbd.ledger.v1.LedgerService/Retract` on the `ledger` backend.",
        "operationId": "LedgerService.Retract",
        "parameters": [
          {
            "name": "subject_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "`tbd.ledger.v1.RetractRequest`; path variables override their fields",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/tbd.ledger.v1.RetractRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "`tbd.ledger.v1.RetractResponse`",
