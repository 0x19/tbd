          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/tbd.ledger.v1.RestoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "`tbd.ledger.v1.RestoreResponse`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/tbd.ledger.v1.RestoreResponse"
                }
              }
