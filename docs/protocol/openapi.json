        "responses": {
          "200": {
            "description": "`tbd.ledger.v1.HistoryResponse`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/tbd.ledger.v1.HistoryResponse"
                }
              }
            }
          },
          "default": {
