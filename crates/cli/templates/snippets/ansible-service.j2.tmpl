  @@name@@:
    image: {{ @@name@@_image }}:{{ image_tag }}
    environment:
      RUST_LOG: {{ rust_log }}
      LOG_FORMAT: {{ log_format }}
      TBD_ENV: production
      @@NAME@@_LISTEN_ADDR: 0.0.0.0:{{ @@name@@_port }}
      @@NAME@@_METRICS_ADDR: 0.0.0.0:9464
      OTEL_EXPORTER_OTLP_ENDPOINT: "{{ otlp_endpoint | default('') }}"
      PYROSCOPE_SERVER_ADDRESS: "{{ pyroscope_server | default('') }}"
    restart: unless-stopped
