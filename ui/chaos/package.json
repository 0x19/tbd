{
  "name": "chaos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/*.mjs\" next.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"e2e/*.mjs\" next.config.ts",
    "e2e": "playwright install chromium && node e2e/smoke.mjs"
  },
  "dependencies": {
