# Copy to devops/edge/.env (git-ignored). docker compose reads it from this directory.
# Hosts served: api.<BASE_DOMAIN>, grafana.<BASE_DOMAIN>, logs.<BASE_DOMAIN>,
# profiles.<BASE_DOMAIN>, metrics.<BASE_DOMAIN>. Each needs a DNS record.
BASE_DOMAIN=example.com
ACME_EMAIL=you@example.com
# One credential guards grafana/logs/profiles/metrics. `mise run edge:password`
# prints a random password once and this line ready to paste. Every `$` in the hash
# is doubled (`$$`) because docker compose expands `$VAR` inside .env files.
OBS_USER=ops
OBS_PASSWORD_HASH=
# Host ports; change when 80/443 are already in use and forward the router to these.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
