# Copy to devops/edge/.env (git-ignored). docker compose reads it from this directory.
# Hosts served: api.<BASE_DOMAIN>, grafana.<BASE_DOMAIN>, logs.<BASE_DOMAIN>,
# profiles.<BASE_DOMAIN>, metrics.<BASE_DOMAIN>. Each needs a DNS record.
# The company site is also served under the apex of each devops/edge/sites.d/*.caddy.
BASE_DOMAIN=example.com
ACME_EMAIL=you@example.com
# Host ports; change when 80/443 are already in use and forward the router to these.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# The company site's own domain when it is canonical somewhere other than the base
# (served from sites.d/, the base domain redirects to it). Defaults to BASE_DOMAIN.
SITE_DOMAIN=
