# Public TLS edge for the local cluster. Runs on the host (docker compose) with
# ports 80 and 443 forwarded from the router. Gets and renews Let's Encrypt
# certificates itself, then hands everything to the cluster's host ports.
#
# One base domain, fixed subdomains:
#   api.<base>       Envoy edge :18080  (REST, SSE, GraphQL, WebSocket, gRPC)   public
#   grafana.<base>, logs.<base>, profiles.<base>, metrics.<base>, chaosadmin.<base>
#                    Envoy :18080, which signs the browser in through Ory Hydra
#   finance.<base>   the finance UI; the bank OAuth callback is open, the rest gated
#   cv.<base>        the full CV behind the sign-in and the owner's approval
#   auth.<base>      sign-in: Ory Hydra + Kratos + login pages, via Envoy :18080      public
#   <base>           the company site (ui/www), Envoy's `www.*` host                  public
#                    www.<base> redirects to the apex, so there is one canonical URL;
#                    with SITE_DOMAIN set (the site on a domain of its own, sites.d/),
#                    the apex redirects there too, and api.<site> may serve the API
#
# Env: BASE_DOMAIN, ACME_EMAIL, SITE_DOMAIN (compose defaults it to BASE_DOMAIN).
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

# Everything that is not the API goes through Envoy's gated virtual hosts: the
# sign-in happens there (Ory Hydra), not here. Caddy only adds TLS.
(gated) {
	encode zstd gzip
	reverse_proxy cluster:18080 {
		header_up X-Forwarded-Proto https
	}
	log {
		output stdout
		format json
	}
}

# The API host. A snippet so that the site's own domain can carry it as well
# (`api.<site>` in sites.d/); Envoy's API virtual host matches any name.
(api) {
	encode zstd gzip

	# gRPC needs an end-to-end HTTP/2 stream: clients arrive over h2 with TLS,
	# Envoy takes h2c behind. Matched on content type so nothing else uses the
	# h2c transport; Caddy cannot carry a WebSocket upgrade over it.
	@grpc header Content-Type application/grpc*
	reverse_proxy @grpc cluster:18080 {
		transport http {
			versions h2c
		}
		flush_interval -1
		header_up X-Forwarded-Proto https
	}

	# REST, SSE, GraphQL and WebSocket upgrades go over HTTP/1.1.
	# flush_interval -1 streams SSE without buffering.
	reverse_proxy cluster:18080 {
		flush_interval -1
		header_up X-Forwarded-Proto https
	}

	log {
		output stdout
		format json
	}
}

api.{$BASE_DOMAIN} {
	import api
}

grafana.{$BASE_DOMAIN} {
	import gated
}

logs.{$BASE_DOMAIN} {
	import gated
}

profiles.{$BASE_DOMAIN} {
	import gated
}

metrics.{$BASE_DOMAIN} {
	import gated
}

# The chaos admin UI: same login as the others (Envoy's `chaosadmin.*` host).
chaosadmin.{$BASE_DOMAIN} {
	import gated
}

# The finance service's browser surface. Envoy's `finance.*` host decides what is
# open and what needs the login; today the only route is the bank's OAuth callback.
finance.{$BASE_DOMAIN} {
	import gated
}

# The full CV: request, approve, download (docs/cv/README.md). Envoy's `cv.*`
# host signs the browser in like the others.
cv.{$BASE_DOMAIN} {
	import gated
}

# Where people sign in: Ory Hydra, Kratos and the login pages, via Envoy.
auth.{$BASE_DOMAIN} {
	import gated
}

# The company site. Public, no sign-in. The Host is rewritten to the www name
# because that is what Envoy's public `www.*` virtual host matches, which keeps
# the domain itself out of envoy.yaml.
(site) {
	encode zstd gzip
	reverse_proxy cluster:18080 {
		header_up Host www.{$BASE_DOMAIN}
		header_up X-Forwarded-Proto https
	}
	log {
		output stdout
		format json
	}
}

# One canonical name for the site. www redirects to it, and so does the base
# domain's apex when the site lives on a domain of its own (SITE_DOMAIN, served
# from sites.d/): the same build answering on two names would be duplicate
# content, and the one it names as canonical must be the one people can reach.
# With SITE_DOMAIN equal to the base (the compose default) the apex serves the
# site itself and nothing redirects.
www.{$BASE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$BASE_DOMAIN} {
	@elsewhere not host {$SITE_DOMAIN}
	redir @elsewhere https://{$SITE_DOMAIN}{uri} permanent
	import site
}

# The site under a domain of its own (a company domain while the platform stays
# on the base): one file per domain in sites.d/, git-ignored like .env, each an
# apex importing `site`, a www redirecting to it, and optionally `api.<domain>`
# importing `api`. See sites.d/README.md.
# A glob that matches nothing imports nothing.
import sites.d/*.caddy
