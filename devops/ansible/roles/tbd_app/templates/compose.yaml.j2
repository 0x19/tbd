# Rendered by ansible (role tbd_app). Do not edit on the host.
name: {{ compose_project }}

services:
  engine:
    image: {{ engine_image }}:{{ image_tag }}
    environment:
      RUST_LOG: {{ rust_log }}
      LOG_FORMAT: {{ log_format }}
      ENGINE_LISTEN_ADDR: 0.0.0.0:{{ engine_port }}
      ENGINE_METRICS_ADDR: 0.0.0.0:9464
      OTEL_EXPORTER_OTLP_ENDPOINT: "{{ otlp_endpoint | default('') }}"
      PYROSCOPE_SERVER_ADDRESS: "{{ pyroscope_server | default('') }}"
    restart: unless-stopped

  protocol:
    image: {{ protocol_image }}:{{ image_tag }}
    environment:
      RUST_LOG: {{ rust_log }}
      LOG_FORMAT: {{ log_format }}
      PROTOCOL_LISTEN_ADDR: 0.0.0.0:{{ protocol_port }}
      PROTOCOL_METRICS_ADDR: 0.0.0.0:9465
      OTEL_EXPORTER_OTLP_ENDPOINT: "{{ otlp_endpoint | default('') }}"
      PYROSCOPE_SERVER_ADDRESS: "{{ pyroscope_server | default('') }}"
      PROTOCOL_ENGINE_URL: http://engine:{{ engine_port }}
    ports:
      - "{{ protocol_port }}:{{ protocol_port }}"
    depends_on:
      - engine
    restart: unless-stopped
  ledger:
    image: {{ ledger_image }}:{{ image_tag }}
    environment:
      RUST_LOG: {{ rust_log }}
      LOG_FORMAT: {{ log_format }}
      TBD_ENV: production
      LEDGER_LISTEN_ADDR: 0.0.0.0:{{ ledger_port }}
      LEDGER_METRICS_ADDR: 0.0.0.0:9464
      OTEL_EXPORTER_OTLP_ENDPOINT: "{{ otlp_endpoint | default('') }}"
      PYROSCOPE_SERVER_ADDRESS: "{{ pyroscope_server | default('') }}"
    restart: unless-stopped
  humans:
    image: {{ humans_image }}:{{ image_tag }}
    environment:
      RUST_LOG: {{ rust_log }}
      LOG_FORMAT: {{ log_format }}
      TBD_ENV: production
      HUMANS_LISTEN_ADDR: 0.0.0.0:{{ humans_port }}
      HUMANS_METRICS_ADDR: 0.0.0.0:9464
      OTEL_EXPORTER_OTLP_ENDPOINT: "{{ otlp_endpoint | default('') }}"
      PYROSCOPE_SERVER_ADDRESS: "{{ pyroscope_server | default('') }}"
    restart: unless-stopped
{% if chaos_enabled | default(false) %}

  # chaos API + admin UI. Off by default; dev hosts set chaos_enabled: true.
  chaos:
    image: {{ chaos_image | default(engine_image | regex_replace('engine$', 'chaos')) }}:{{ image_tag }}
    command: ["serve"]
    environment:
      RUST_LOG: {{ rust_log }}
      LOG_FORMAT: {{ log_format }}
      TBD_ENV: {{ tbd_env | default('dev') }}
      CHAOS_LISTEN_ADDR: 0.0.0.0:7700
      CHAOS_PROTOCOL_URL: http://protocol:{{ protocol_port }}
      CHAOS_ENGINE_URL: http://engine:{{ engine_port }}
      CHAOS_HUMANS_URL: http://humans:{{ humans_port }}
      CHAOS_LEDGER_URL: http://ledger:{{ ledger_port }}
      CHAOS_RESULTS_DIR: /data/results
      CHAOS_SCHEDULES_FILE: /data/schedules.json
      CHAOS_STACK_FILE: /data/stack.json
      CHAOS_SLACK_WEBHOOK: "{{ chaos_slack_webhook | default('') }}"
      CHAOS_SCENARIOS_DIR: /data/scenarios
      CHAOS_SCENARIOS_SEED: /app/scenarios
      CHAOS_UI_DIR: /app/ui
      CHAOS_PUBLIC_DOMAIN: "{{ base_domain | default('') }}"
      # Tokens for validate/load through Envoy; the identity stack itself is not part of
      # this compose (see docs/auth/README.md), so point at the environment's Hydra.
      CHAOS_AUTH_TOKEN_URL: "{{ chaos_auth_token_url | default('') }}"
      CHAOS_AUTH_CLIENT_ID: tbd-chaos
      CHAOS_AUTH_CLIENT_SECRET: "{{ chaos_auth_client_secret | default('') }}"
      OTEL_EXPORTER_OTLP_ENDPOINT: "{{ otlp_endpoint | default('') }}"
    volumes:
      - chaos-results:/data
    tmpfs:
      - /tmp
    ports:
      - "{{ chaos_port | default(7700) }}:7700"
    restart: unless-stopped

volumes:
  chaos-results:
{% endif %}
